/.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock

# Local resolution only: points `dartnative` at the SDK copy so `dart test` and
# `dart analyze` work at the plugin root. Machine-specific — never published.
/pubspec_overrides.yaml
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
# DartNative's equivalent of the line above; `dn pub get` writes it wherever
# it runs, and example/.gitignore already ignores its copy.
.dn-plugins-dependencies
/build/
/coverage/

# `dn plugin build` output: the distributable tarball plus its scratch dirs.
/dist/
